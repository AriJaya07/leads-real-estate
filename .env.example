# Copy to .env and fill in. Every value here is a secret or a deployment
# identity. Anything operational — which datasets to sync, which actors to watch,
# sync intervals, alert recipients — is configured in the admin UI, not here.

# --- Database (required) ---
DATABASE_URL=postgresql://user:password@host:5432/dreamrue

# --- Apify (required) ---
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx
# Shared secret for POST /api/webhooks/apify. Min 16 chars.
APIFY_WEBHOOK_SECRET=

# --- Platform secrets (required) ---
# Signs session cookies. Min 32 chars.
AUTH_SECRET=

# Restricts which addresses may create a new company via /signup. Leave empty
# to let anyone create a company. Existing companies add teammates from
# Admin -> Team (direct or invite), which never consults this value.
AUTH_ALLOWED_EMAILS=you@example.com

# Public base URL — used to build absolute links in invite/password-reset
# emails. Defaults to http://localhost:3000 in development.
APP_URL=https://app.dreamrue.example

# --- Email (optional) ---
# Used for team invites, password resets, and lead alerts. Without a key,
# these are logged instead of sent — invites/resets still work via the
# on-screen link, and the app still runs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DreamRue Lead Radar <onboarding@resend.dev>

# --- WhatsApp (optional) ---
# WhatsApp Cloud API. Only used for lead alerts. Without both, alerts are
# logged instead of sent and the app still runs.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- n8n scheduler (optional) ---
# Shared secret for POST /api/trigger/{discover,sync,fx,retention} — an n8n
# workflow should call these on a schedule now that the old Vercel crons are
# gone. Min 16 chars. Unset = every trigger route responds 401 to everything.
N8N_TRIGGER_SECRET=

# --- LLM shadow classifier (optional) ---
# Runs an LLM classification alongside the real rules classifier for
# comparison logging only — never affects a persisted lead. Both must be set
# to activate; unset (either one) means zero extra API calls.
ANTHROPIC_API_KEY=
LLM_SHADOW_CLASSIFY_ENABLED=
