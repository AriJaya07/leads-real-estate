# Copy to .env and fill in. Every value here is a secret or a deployment
# identity. Anything operational — which datasets to sync, which actors to watch,
# sync intervals, alert recipients — is configured in the admin UI, not here.

# --- Database (required) ---
DATABASE_URL=postgresql://user:password@host:5432/dreamrue

# --- Apify (required) ---
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx
# Shared secret for POST /api/webhooks/apify. Min 16 chars.
APIFY_WEBHOOK_SECRET=

# --- Platform secrets (required) ---
# Signs session cookies. Min 32 chars.
AUTH_SECRET=

# Bootstrap guard only: restricts which address may claim the instance as the
# first admin. Leave empty to let the first sign-in claim it. After that,
# accounts are created by an admin in Admin -> Team; this value is not consulted.
AUTH_ALLOWED_EMAILS=you@example.com

# --- Email (optional) ---
# Only used for lead alerts. Sign-in never needs it. Without a key, alerts are
# logged instead of sent and the app still runs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DreamRue Lead Radar <onboarding@resend.dev>
