# Copy to .env.test and fill in. Integration tests run against a *disposable*
# database — never point this at the same database as .env's DATABASE_URL.
# `resetDb()` in test/integration/db-helpers.ts truncates every app table between
# tests and refuses to run unless this URL's database name contains "test", as a
# guard against accidentally wiping a dev/prod database from a misconfigured run.

# createdb dreamrue_test
DATABASE_URL=postgresql://user:password@localhost:5432/dreamrue_test

# Same validation shape as shared/config/env.ts — any value satisfying the length
# minimums works, these don't need to be real.
APIFY_API_TOKEN=test-token
APIFY_WEBHOOK_SECRET=test-webhook-secret-min16
CRON_SECRET=test-cron-secret-min16
AUTH_SECRET=test-auth-secret-at-least-32-characters-long
