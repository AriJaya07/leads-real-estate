# Copy to .env.e2e and fill in. Playwright's webServer boots the app against
# this database — never point it at .env's DATABASE_URL. e2e/global-setup.ts
# seeds a fixed admin user + one lead directly via SQL before the suite runs.

# createdb dreamrue_e2e
DATABASE_URL=postgresql://user:password@localhost:5432/dreamrue_e2e

APIFY_API_TOKEN=test-token
APIFY_WEBHOOK_SECRET=test-webhook-secret-min16
CRON_SECRET=test-cron-secret-min16
AUTH_SECRET=test-auth-secret-at-least-32-characters-long
AUTH_ALLOWED_EMAILS=e2e@dreamrue.test
