{
  "name": "Trigger - Sync Datasets",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "id": "36e18970-6d01-4e90-b900-12c826898125",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DREAMRUE_APP_URL }}/api/trigger/sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "db7fab23-4e4c-440f-a43f-8140b51e968f",
      "name": "POST /api/trigger/sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "DreamRue Trigger Secret"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json[\"ok\"] }}",
              "value2": true
            }
          ]
        }
      },
      "id": "8a2453f9-92a5-4d58-997d-0bb59b117f73",
      "name": "ok === true?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {},
      "id": "6cf50c6d-fd40-4f28-b88a-f49f26249619",
      "name": "Success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {},
      "id": "2642bdb5-a9b3-47bf-a299-9ef3466a14d9",
      "name": "Business Failure (ok:false / partial failures)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        900,
        400
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "POST /api/trigger/sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /api/trigger/sync": {
      "main": [
        [
          {
            "node": "ok === true?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ok === true?": {
      "main": [
        [
          {
            "node": "Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Business Failure (ok:false / partial failures)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "_Shared Error Handler",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "meta": {
    "instanceId": "REPLACE_ON_IMPORT",
    "templateNote": "Calls dueDatasets()+syncDataset() via POST /api/trigger/sync. Core ingestion tick. maxDuration=300s server-side; HTTP timeout set to 300000ms below (override the 60000ms default)."
  },
  "id": "5156d56e-b6c4-4335-8f83-af10c23ba322",
  "tags": [
    {
      "name": "dreamrue"
    },
    {
      "name": "n8n-integration-plan"
    }
  ]
}
