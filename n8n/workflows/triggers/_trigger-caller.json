{
  "name": "_Trigger Caller",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "a1b2c3d4-0001-4a1b-9c1d-000000000001",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AVERONAI_APP_URL }}/api/trigger/{{ $json.route }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": "={{ $json.timeoutMs }}",
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1b2c3d4-0001-4a1b-9c1d-000000000002",
      "name": "POST /api/trigger/{route}",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "AveronAi Trigger Secret"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json[\"ok\"] }}",
              "value2": true
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4a1b-9c1d-000000000003",
      "name": "ok === true?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-4a1b-9c1d-000000000004",
      "name": "Success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-4a1b-9c1d-000000000005",
      "name": "Business Failure (ok:false / partial failures)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 400]
    }
  ],
  "connections": {
    "When Called": {
      "main": [[{ "node": "POST /api/trigger/{route}", "type": "main", "index": 0 }]]
    },
    "POST /api/trigger/{route}": {
      "main": [[{ "node": "ok === true?", "type": "main", "index": 0 }]]
    },
    "ok === true?": {
      "main": [
        [{ "node": "Success", "type": "main", "index": 0 }],
        [{ "node": "Business Failure (ok:false / partial failures)", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "_Shared Error Handler",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "meta": {
    "instanceId": "REPLACE_ON_IMPORT",
    "templateNote": "Shared logic for every 0X-trigger-*.json workflow — one place for the credential, retry policy, timeout handling, and ok/fail branch instead of 7 copies of the same 5 nodes. Called via an Execute Workflow node with input { route: \"discover\"|\"sync\"|\"fx\"|\"retention\"|\"weekly-report\"|\"auto-assign\"|\"reminders\", timeoutMs: number }. Import this FIRST, alongside _Shared Error Handler — every trigger workflow's Execute Workflow node references it by id, assigned at import time, so re-select '_Trigger Caller' from that node's workflow dropdown in each of the 7 callers after import (same caveat as the Error Workflow dropdown, see n8n/README.md)."
  },
  "id": "a1b2c3d4-0001-4a1b-9c1d-000000000000",
  "tags": [
    { "name": "averonai" },
    { "name": "n8n-integration-plan" }
  ]
}
